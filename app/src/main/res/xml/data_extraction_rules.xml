<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve user settings in cloud backups -->
        <include domain="sharedpref" path="." />
        <!-- Exclude sensitive personal audio recordings and raw database from cloud backups -->
        <exclude domain="database" path="personal_ai.db" />
        <exclude domain="database" path="personal_ai.db-shm" />
        <exclude domain="database" path="personal_ai.db-wal" />
        <exclude domain="file" path="recordings" />
        <!-- Exclude secure credential vault from cloud backups -->
        <exclude domain="sharedpref" path="secure_credentials_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Include preferences and database on direct encrypted device-to-device migration -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="personal_ai.db" />
        <include domain="database" path="personal_ai.db-shm" />
        <include domain="database" path="personal_ai.db-wal" />
        <!-- Exclude bulky raw audio recordings to prevent migration timeouts -->
        <exclude domain="file" path="recordings" />
        <!-- Exclude secure credential vault (device-specific hardware keys) -->
        <exclude domain="sharedpref" path="secure_credentials_vault.xml" />
    </device-transfer>
</data-extraction-rules>
