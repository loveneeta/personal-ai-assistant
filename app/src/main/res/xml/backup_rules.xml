<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include user settings and preferences for seamless device migration -->
    <include domain="sharedpref" path="." />

    <!-- Exclude private SQLite databases and voice recordings from unencrypted cloud/adb backups -->
    <exclude domain="database" path="personal_ai.db" />
    <exclude domain="database" path="personal_ai.db-shm" />
    <exclude domain="database" path="personal_ai.db-wal" />
    <exclude domain="file" path="recordings" />
</full-backup-content>
